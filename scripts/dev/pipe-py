#!/usr/bin/env bash
# 在训练机上跑仓库里的一个只用标准库的 Python 脚本：脚本经 ssh stdin 传过去，在远端仓库副本的根目录执行。
# 不同步仓库，所以训练链在跑（runs/.chain-active-* 存在、scripts/dev/remote 拒绝同步）时也能用。主机按 V2D_ENV 选（同 scripts/dev/remote）。
# 远端用宿主机的 python3（mf4090、ml40 都是 3.10），脚本不能依赖 numpy 等第三方包。
# 用法：scripts/dev/pipe-py <仓内 .py> [参数...]
# 落盘：scripts/dev/record <名字> scripts/dev/pipe-py <仓内 .py> [参数...]（record 会记下两个文件的 md5）
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd -P)"
. "$ROOT/scripts/dev/_load-env" >/dev/null
PY=${1:?用法：pipe-py <仓内 .py> [参数...]}; shift
[[ $PY == *.py && $PY != /* && $PY != *..* ]] && [ -f "$ROOT/$PY" ] || { echo "pipe-py: 不是仓内的 .py：$PY" >&2; exit 2; }
for a in "$@"; do
  [[ $a =~ ^[A-Za-z0-9_./=:,+-]+$ && $a != *..* ]] || { echo "pipe-py: 参数非法：$a" >&2; exit 2; }
done
ssh -o ConnectTimeout=20 "$V2D_HOST" "cd '$V2D_REMOTE' && python3 - $*" < "$ROOT/$PY"
