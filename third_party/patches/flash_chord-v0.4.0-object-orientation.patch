+# SPDX-License-Identifier: Apache-2.0
+"""V2D object-orientation reward switch for the ReconBody objective (not part of upstream FlashCHORD).
+
+The training copy adds a 13th ReconBody objective term, ``object_orientation`` = exp(-theta^2 / std^2), where theta is the
+geodesic angle between the simulated object and its command target (the same quantity the termination check uses).
+Its weight and std come from the environment, not from Hydra: a checkpoint stores its resolved configuration, and the
+evaluator (a copy byte-identical to upstream 8c778f9) rebuilds the environment from it, so any extra key would make the
+evaluator reject the checkpoint. Curricula therefore keep the 12 upstream names; the 13th weight is the same in every
+stage. With the default weight 0 the objective score equals the upstream score bit for bit.
+"""
+
+import math
+import os
+
+OBJECT_ORIENTATION_TERM = "object_orientation"
+WEIGHT_ENV = "V2D_OBJ_ORI_WEIGHT"
+STD_ENV = "V2D_OBJ_ORI_STD"
+
+
+def object_orientation_params() -> tuple[float, float]:
+    """Return (weight, std); the weight must be finite and non-negative, the std finite and positive."""
+    weight = float(os.environ.get(WEIGHT_ENV, "0"))
+    std = float(os.environ.get(STD_ENV, "0.4"))
+    if not math.isfinite(weight) or weight < 0.0:
+        raise ValueError(f"{WEIGHT_ENV} must be finite and non-negative, got {weight}")
+    if not math.isfinite(std) or std <= 0.0:
+        raise ValueError(f"{STD_ENV} must be finite and positive, got {std}")
+    return weight, std
