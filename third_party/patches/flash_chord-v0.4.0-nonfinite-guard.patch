+@wp.kernel
+def clear_nonfinite_solver_rows(
+    reset_mask: wp.array(dtype=wp.int32),
+    values: wp.array2d(dtype=wp.float32),
+) -> None:
+    """V2D non-finite guard: zero a reset world's solver row when any entry of it is non-finite."""
+    world = wp.tid()
+    if reset_mask[world] == 0:
+        return
+    bad = int(0)  # noqa: UP018,RUF046 - Warp requires explicitly typed mutable locals.
+    for column in range(values.shape[1]):
+        if not wp.isfinite(values[world, column]):
+            bad = 1
+    if bad != 0:
+        for column in range(values.shape[1]):
+            values[world, column] = 0.0
+
+
+def _solver_rows_to_clear(solver, world_count: int) -> tuple[wp.array, ...]:
+    """MuJoCo-Warp state that survives a Newton reset: the warm-start acceleration and, when present, activations."""
+    data = getattr(solver, "mjw_data", None)
+    if data is None:
+        return ()
+    rows = []
+    for name in ("qacc_warmstart", "act"):
+        values = getattr(data, name, None)
+        if values is None or values.ndim != 2 or values.shape[1] == 0:
+            continue
+        if values.shape[0] != world_count:
+            raise ValueError(f"mjw_data.{name} has {values.shape[0]} worlds; expected {world_count}")
+        rows.append(values)
+    return tuple(rows)
+
