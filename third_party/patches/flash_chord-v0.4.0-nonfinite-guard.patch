+# SPDX-License-Identifier: Apache-2.0
+"""V2D non-finite guard for FlashSAC collection (not part of upstream FlashCHORD).
+
+Added by the V2D repository's third_party/patches/flash_chord-v0.4.0-nonfinite-guard.patch; design and gates in its
+agent-doc/plan-ep7-eval-and-guards-2026-10-02.md, part B.
+
+A simulator world can turn non-finite, or grow observations that overflow the fp16 replay storage. Upstream FlashSAC
+has no filter for this: a single such world-step poisons the reward normalizer, the replay buffer and the BatchNorm
+statistics for the rest of the run. `make_transition_sanitizer` builds a separately jitted function that runs before
+`consume_transition`, so the learner's compiled program is unchanged. When no world is bad, every array it returns
+equals its input bit for bit (only `jnp.where` with an all-false mask touches the data).
+
+A world-step is bad when the environment flagged it (termination writes the pelvis-position-error sentinel -1 for a
+world with a non-finite or far-away body, see lifecycle/termination.py), or when any of its objective terms, action,
+next or post-reset observation or critic context is non-finite, or an observation overflows the replay storage dtype.
+For a bad world-step the transition becomes an ordinary failure sample: objective terms are (termination=1, others 0),
+`terminated` is set, the termination cause is pelvis, and non-finite actions become 0. Each of the four observation and
+context arrays is replaced by the learner's current observation or context only where that array itself is non-finite
+(or overflows the storage dtype): an environment-flagged world has already been reset by the environment, so its
+post-reset observation is the new episode's first observation and is kept. A world that only the learner flags is not
+reset by the environment; its replaced post-reset observation lags the simulator by one step and its `terminated`
+adds one completed episode to the learner's logging. The sentinel is counted and then cleared to 0, so it never
+reaches the tracking-error metrics.
+
+Counters are kept outside the learner state, so they are not checkpointed (a resumed run starts them from 0). They are
+reported once per logging window: the runner prints an `EVENT_PREFIX` line for a window with events and a `STOP_PREFIX`
+line before it stops training because the guard keeps firing.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import flax
+import jax
+import jax.numpy as jnp
+
+ENV_FLAG_PELVIS_ERROR = -1.0
+STOP_LEARNER_ONLY_TOTAL = 100
+STOP_CONSECUTIVE = 3
+EVENT_PREFIX = "NONFINITE_GUARD_EVENT"
+STOP_PREFIX = "NONFINITE_GUARD_STOP"
+
+
+@flax.struct.dataclass
+class GuardState:
+    """Device-resident guard counters; window fields are cleared after each logging window."""
+
+    consecutive: jax.Array
+    env_flagged: jax.Array
+    learner_only: jax.Array
+    learner_only_total: jax.Array
+    max_consecutive: jax.Array
+    phase_min: jax.Array
+    phase_max: jax.Array
+    first_world: jax.Array
+
+
+@dataclass(frozen=True)
+class GuardLayout:
+    """Static indices the sanitizer needs; resolved once from the environment and training config."""
+
+    storage_dtype: str
+    termination_term: int
+    objective_term_count: int
+    cause_count: int
+    pelvis_cause: int
+    pelvis_error_column: int
+    phase_index: int
+
+
+def create_guard_state(world_count: int, device: jax.Device | None = None) -> GuardState:
+    def put(value):
+        return value if device is None else jax.device_put(value, device)
+
+    return GuardState(
+        consecutive=put(jnp.zeros((world_count,), dtype=jnp.int32)),
+        env_flagged=put(jnp.asarray(0, dtype=jnp.int32)),
+        learner_only=put(jnp.asarray(0, dtype=jnp.int32)),
+        learner_only_total=put(jnp.asarray(0, dtype=jnp.int32)),
+        max_consecutive=put(jnp.asarray(0, dtype=jnp.int32)),
+        phase_min=put(jnp.asarray(jnp.inf, dtype=jnp.float32)),
+        phase_max=put(jnp.asarray(-jnp.inf, dtype=jnp.float32)),
+        first_world=put(jnp.asarray(-1, dtype=jnp.int32)),
+    )
+
+
+def guard_layout(
+    *,
+    storage_dtype: str,
+    objective_term_names: tuple[str, ...],
+    termination_cause_names: tuple[str, ...],
+    tracking_error_names: tuple[str, ...],
+    critic_context_names: tuple[str, ...],
+) -> GuardLayout:
+    """Resolve the column indices by name; a missing name is recorded as -1.
+
+    Without a "termination" objective term a bad world-step gets all-zero objective terms; without a "pelvis" cause
+    the first cause is marked instead (no cause at all leaves the causes alone); without a pelvis position error
+    column no world can be environment-flagged. The ReconBody recipe has all of them.
+    """
+    names = tuple(objective_term_names)
+    causes = tuple(termination_cause_names)
+    errors = tuple(tracking_error_names)
+    context = tuple(critic_context_names)
+    pelvis_cause = causes.index("pelvis") if "pelvis" in causes else (0 if causes else -1)
+    return GuardLayout(
+        storage_dtype=str(jnp.dtype(storage_dtype)),
+        termination_term=names.index("termination") if "termination" in names else -1,
+        objective_term_count=len(names),
+        cause_count=len(causes),
+        pelvis_cause=pelvis_cause,
+        pelvis_error_column=(
+            len(causes) + errors.index("pelvis_position_m") if "pelvis" in causes and "pelvis_position_m" in errors else -1
+        ),
+        phase_index=context.index("normalized_reference_phase") if "normalized_reference_phase" in context else -1,
+    )
+
+
+def _rows_finite(values: jax.Array) -> jax.Array:
+    return jnp.all(jnp.isfinite(values), axis=-1)
+
+
+def make_transition_sanitizer(layout: GuardLayout):
+    """Return a jitted `(transition, observation, critic_context, state) -> (transition, state)` function."""
+    storage_dtype = jnp.dtype(layout.storage_dtype)
+    termination_row = jnp.zeros((layout.objective_term_count,), dtype=jnp.float32)
+    if layout.termination_term >= 0:
+        termination_row = termination_row.at[layout.termination_term].set(1.0)
+
+    def observation_ok(values: jax.Array) -> jax.Array:
+        stored = values.astype(storage_dtype)
+        return _rows_finite(values) & _rows_finite(stored)
+
+    def sanitize(transition, observation, critic_context, state: GuardState):
+        diagnostics = transition.termination_diagnostics
+        if layout.pelvis_error_column >= 0:
+            env_flagged = (diagnostics[:, layout.pelvis_cause] == 1.0) & (
+                diagnostics[:, layout.pelvis_error_column] == ENV_FLAG_PELVIS_ERROR
+            )
+        else:
+            env_flagged = jnp.zeros(transition.terminated.shape, dtype=jnp.bool_)
+        next_observation_bad = ~observation_ok(transition.next_observation)
+        post_observation_bad = ~observation_ok(transition.post_reset_observation)
+        next_context_bad = ~_rows_finite(transition.next_critic_context)
+        post_context_bad = ~_rows_finite(transition.post_reset_critic_context)
+        terms_bad = ~_rows_finite(transition.objective_terms)
+        action_bad = ~_rows_finite(transition.action)
+        bad = (
+            env_flagged
+            | next_observation_bad
+            | post_observation_bad
+            | next_context_bad
+            | post_context_bad
+            | terms_bad
+            | action_bad
+        )
+
+        causes = diagnostics[:, : layout.cause_count]
+        if layout.pelvis_cause >= 0:
+            causes = causes.at[:, layout.pelvis_cause].set(jnp.where(bad, 1.0, causes[:, layout.pelvis_cause]))
+        tracking = diagnostics[:, layout.cause_count :]
+        tracking = jnp.where(jnp.isfinite(tracking), tracking, 0.0)
+        if layout.pelvis_error_column >= 0:
+            column = layout.pelvis_error_column - layout.cause_count
+            tracking = tracking.at[:, column].set(jnp.where(env_flagged, 0.0, tracking[:, column]))
+        sanitized = transition.replace(
+            action=jnp.where(bad[:, None] & ~jnp.isfinite(transition.action), 0.0, transition.action),
+            objective_terms=jnp.where(bad[:, None], termination_row[None, :], transition.objective_terms),
+            terminated=jnp.where(bad, jnp.ones_like(transition.terminated), transition.terminated),
+            episode_reference_progress=jnp.where(
+                jnp.isfinite(transition.episode_reference_progress), transition.episode_reference_progress, 0.0
+            ),
+            termination_diagnostics=jnp.concatenate([causes, tracking], axis=1),
+            next_observation=jnp.where(next_observation_bad[:, None], observation, transition.next_observation),
+            next_critic_context=jnp.where(next_context_bad[:, None], critic_context, transition.next_critic_context),
+            post_reset_observation=jnp.where(
+                post_observation_bad[:, None], observation, transition.post_reset_observation
+            ),
+            post_reset_critic_context=jnp.where(
+                post_context_bad[:, None], critic_context, transition.post_reset_critic_context
+            ),
+        )
+
+        consecutive = jnp.where(bad, state.consecutive + 1, 0)
+        learner_only = jnp.sum(bad & ~env_flagged, dtype=jnp.int32)
+        if layout.phase_index >= 0:
+            # The terminal context's phase comes from the integer reference timestep, so it is finite even for a NaN world.
+            phase = transition.next_critic_context[:, layout.phase_index]
+            phase = jnp.where(jnp.isfinite(phase), phase, critic_context[:, layout.phase_index])
+            phase_min = jnp.minimum(state.phase_min, jnp.min(jnp.where(bad, phase, jnp.inf)))
+            phase_max = jnp.maximum(state.phase_max, jnp.max(jnp.where(bad, phase, -jnp.inf)))
+        else:
+            phase_min, phase_max = state.phase_min, state.phase_max
+        first_world = jnp.where(
+            (state.first_world < 0) & jnp.any(bad), jnp.argmax(bad).astype(jnp.int32), state.first_world
+        )
+        state = state.replace(
+            consecutive=consecutive,
+            env_flagged=state.env_flagged + jnp.sum(env_flagged, dtype=jnp.int32),
+            learner_only=state.learner_only + learner_only,
+            learner_only_total=state.learner_only_total + learner_only,
+            max_consecutive=jnp.maximum(state.max_consecutive, jnp.max(consecutive)),
+            phase_min=phase_min,
+            phase_max=phase_max,
+            first_world=first_world,
+        )
+        return sanitized, state
+
+    return jax.jit(sanitize)
+
+
+def window_report(state: GuardState) -> tuple[dict[str, float], str | None]:
+    """Host-side window metrics and, when a registered stop condition holds, the reason to stop."""
+    host = jax.device_get(state)
+    env_flagged = int(host.env_flagged)
+    learner_only = int(host.learner_only)
+    phase_min = float(host.phase_min)
+    phase_max = float(host.phase_max)
+    metrics = {
+        "guard/env_flagged_world_steps": float(env_flagged),
+        "guard/learner_only_world_steps": float(learner_only),
+        "guard/learner_only_world_steps_total": float(int(host.learner_only_total)),
+        "guard/max_consecutive_bad_steps": float(int(host.max_consecutive)),
+        "guard/event_phase_min": phase_min if math.isfinite(phase_min) else -1.0,
+        "guard/event_phase_max": phase_max if math.isfinite(phase_max) else -1.0,
+        "guard/first_bad_world": float(int(host.first_world)),
+    }
+    reason = None
+    if int(host.learner_only_total) > STOP_LEARNER_ONLY_TOTAL:
+        reason = f"learner-only bad world-steps reached {int(host.learner_only_total)} (> {STOP_LEARNER_ONLY_TOTAL})"
+    elif int(host.max_consecutive) >= STOP_CONSECUTIVE:
+        reason = f"a world stayed bad for {int(host.max_consecutive)} consecutive steps (>= {STOP_CONSECUTIVE})"
+    return metrics, reason
+
+
+def event_line(environment_steps: int, metrics: dict[str, float]) -> str:
+    """One greppable host-log line for a logging window that had bad world-steps."""
+    return (
+        f"{EVENT_PREFIX} environment_steps={environment_steps}"
+        f" env_flagged={int(metrics['guard/env_flagged_world_steps'])}"
+        f" learner_only={int(metrics['guard/learner_only_world_steps'])}"
+        f" learner_only_total={int(metrics['guard/learner_only_world_steps_total'])}"
+        f" phase_min={metrics['guard/event_phase_min']:.4f} phase_max={metrics['guard/event_phase_max']:.4f}"
+        f" first_world={int(metrics['guard/first_bad_world'])}"
+        f" longest_streak={int(metrics['guard/max_consecutive_bad_steps'])}"
+    )
+
+
+def stop_line(environment_steps: int, metrics: dict[str, float], reason: str) -> str:
+    """The host-log line printed right before the runner stops training."""
+    return (
+        f"{STOP_PREFIX} environment_steps={environment_steps}"
+        f" learner_only_total={int(metrics['guard/learner_only_world_steps_total'])}"
+        f" longest_streak={int(metrics['guard/max_consecutive_bad_steps'])}"
+        f" first_world={int(metrics['guard/first_bad_world'])} reason={reason!r}"
+    )
+
+
